{
  "model": {
    "name": "synapse_v1",
    "version": "1.0.0",
    "layer_sizes": [
      784,
      128,
      64,
      9
    ],
    "dtype": "float32"
  },
  "data": {
    "classes": [
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8,
      9
    ],
    "val_fraction": 0.1,
    "data_dir": "data/mnist",
    "download": true,
    "split_seed": 42
  },
  "training": {
    "epochs": 30,
    "batch_size": 64,
    "learning_rate": 0.001,
    "optimizer": "adam",
    "adam": {
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-08
    },
    "seed": 42,
    "weight_decay": 0.0001,
    "lr_schedule": "cosine",
    "lr_min_factor": 0.05,
    "selection_metric": "val_loss",
    "early_stopping_patience": 0,
    "augmentation": {
      "enabled": true,
      "rotation_deg": 12.0,
      "scale": 0.1,
      "shear": 0.1,
      "translate_px": 2.0,
      "thicken_prob": 0.2
    }
  },
  "reject": {
    "enabled": true,
    "score": "max_softmax",
    "target_in_distribution_accept": 0.95
  },
  "targets": {
    "test_accuracy": 0.97,
    "latency_ms": 100.0,
    "model_size_mb": 5.0
  },
  "output": {
    "models_dir": "models",
    "runs_dir": "experiments/runs"
  }
}